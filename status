#!/bin/bash

# llm-bencher - Status Checker
# Quick status check of all system components

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}🔍 llm-bencher - System Status${NC}"
echo "=================================================="

# Check if we're in the right directory
if [[ ! -d "backend" ]]; then
    echo -e "${RED}❌ Not in llm-testing-interface directory${NC}"
    exit 1
fi

# Check virtual environment
if [[ -d "backend/venv" ]]; then
    echo -e "${GREEN}✅ Virtual environment exists${NC}"
else
    echo -e "${RED}❌ Virtual environment missing${NC}"
fi

# Check database
if [[ -f "backend/llm_interface.db" ]]; then
    size=$(ls -lh backend/llm_interface.db | awk '{print $5}')
    echo -e "${GREEN}✅ Database exists (${size})${NC}"
else
    echo -e "${RED}❌ Database missing${NC}"
fi

# Check backend server
if curl -s http://127.0.0.1:8000/health >/dev/null 2>&1; then
    echo -e "${GREEN}✅ Backend server running (port 8000)${NC}"
    # Test health endpoint
    health_status=$(curl -s http://127.0.0.1:8000/health | jq -r '.status' 2>/dev/null || echo "unknown")
    echo -e "   Health: ${health_status}"
else
    echo -e "${RED}❌ Backend server not running${NC}"
fi

# Check frontend server
if curl -s http://localhost:3000 >/dev/null 2>&1; then
    echo -e "${GREEN}✅ Frontend server running (port 3000)${NC}"
else
    echo -e "${RED}❌ Frontend server not running${NC}"
fi

# Check logs directory
if [[ -d "logs" ]]; then
    echo -e "${GREEN}✅ Logs directory exists${NC}"
    if [[ -f "logs/backend.log" ]]; then
        echo -e "   Backend log: $(ls -lh logs/backend.log | awk '{print $5}')"
    fi
    if [[ -f "logs/frontend.log" ]]; then
        echo -e "   Frontend log: $(ls -lh logs/frontend.log | awk '{print $5}')"
    fi
else
    echo -e "${YELLOW}⚠️ Logs directory missing${NC}"
fi

echo "=================================================="
echo -e "${BLUE}Quick Commands:${NC}"
echo "  ./start     - Start everything"
echo "  ./stop      - Stop everything"
echo "  ./test      - Run full system tests"
echo "  ./status    - Show this status (you are here)"
echo ""
echo -e "${BLUE}URLs:${NC}"
echo "  Frontend:    http://localhost:3000"
echo "  Backend API: http://127.0.0.1:8000"
echo "  API Docs:    http://127.0.0.1:8000/docs"
