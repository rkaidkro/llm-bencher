#!/bin/bash

# llm-bencher - One-Command Startup
# This script starts everything with comprehensive error checking and logging

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging function
log() {
    echo -e "${BLUE}[$(date +'%Y-%m-%d %H:%M:%S')]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

log "🚀 Starting llm-bencher"
log "📁 Working directory: $(pwd)"

# Check if we're in the right place
if [[ ! -d "backend" ]]; then
    error "Backend directory not found! Make sure you're in the llm-testing-interface directory"
    exit 1
fi

# Check if virtual environment exists
if [[ ! -d "backend/venv" ]]; then
    error "Virtual environment not found in backend/venv"
    error "Please run: cd backend && python3 -m venv venv"
    exit 1
fi

# Function to check if a port is in use
check_port() {
    local port=$1
    if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1; then
        return 0  # Port is in use
    else
        return 1  # Port is free
    fi
}

# Function to kill processes on a port
kill_port() {
    local port=$1
    if check_port $port; then
        warning "Port $port is in use. Stopping existing processes..."
        lsof -ti:$port | xargs kill -9 2>/dev/null || true
        sleep 2
    fi
}

# Step 1: Activate virtual environment and check Python
log "🔧 Step 1: Checking Python environment..."
source backend/venv/bin/activate
if ! python --version >/dev/null 2>&1; then
    error "Python not found in virtual environment"
    exit 1
fi
success "Python environment ready: $(python --version)"

# Step 2: Check dependencies
log "📦 Step 2: Checking dependencies..."
if ! python -c "import fastapi, uvicorn, requests" 2>/dev/null; then
    error "Missing required dependencies. Installing..."
    pip install -r backend/requirements.txt
fi
success "Dependencies ready"

# Step 3: Initialize database
log "🗄️ Step 3: Initializing database..."
if ! python -c "from backend.app.main import init_db; init_db(); print('Database ready')" 2>/dev/null; then
    error "Database initialization failed"
    exit 1
fi
success "Database initialized"

# Step 4: Start backend server
log "🌐 Step 4: Starting backend server..."
kill_port 8000

# Start backend in background with proper logging
cd backend
python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload > ../logs/backend.log 2>&1 &
BACKEND_PID=$!
cd ..

# Wait for backend to start
log "⏳ Waiting for backend to start..."
for i in {1..10}; do
    if check_port 8000; then
        success "Backend server running on http://127.0.0.1:8000"
        break
    fi
    sleep 1
done

if ! check_port 8000; then
    error "Backend server failed to start"
    kill $BACKEND_PID 2>/dev/null || true
    exit 1
fi

# Step 5: Test backend health
log "🧪 Step 5: Testing backend health..."
sleep 2  # Give it a moment to fully start
if curl -s http://127.0.0.1:8000/health >/dev/null 2>&1; then
    success "Backend health check passed"
else
    warning "Backend health check failed, but server is running"
fi

# Step 6: Start frontend (simple Python server for now)
log "🎨 Step 6: Starting frontend..."
kill_port 3000

# Start simple frontend in background
python simple_frontend.py > logs/frontend.log 2>&1 &
FRONTEND_PID=$!

# Wait for frontend to start
log "⏳ Waiting for frontend to start..."
for i in {1..10}; do
    if check_port 3000; then
        success "Frontend server running on http://localhost:3000"
        break
    fi
    sleep 1
done

if ! check_port 3000; then
    error "Frontend server failed to start"
    kill $BACKEND_PID $FRONTEND_PID 2>/dev/null || true
    exit 1
fi

# Success!
echo
success "🎉 llm-bencher is now running!"
echo "=================================================="
echo "🌐 Frontend:    http://localhost:3000"
echo "🔧 Backend API: http://127.0.0.1:8000"
echo "📚 API Docs:    http://127.0.0.1:8000/docs"
echo "🏥 Health:      http://127.0.0.1:8000/health"
echo "=================================================="
echo
echo "📋 Logs:"
echo "   Backend:  tail -f logs/backend.log"
echo "   Frontend: tail -f logs/frontend.log"
echo
echo "🛑 To stop: Press Ctrl+C or run './stop'"
echo

# Create stop script
cat > stop << 'EOF'
#!/bin/bash
echo "🛑 Stopping LLM Testing Interface..."
pkill -f "uvicorn.*8000" 2>/dev/null || true
pkill -f "simple_frontend.py" 2>/dev/null || true
lsof -ti:8000 | xargs kill -9 2>/dev/null || true
lsof -ti:3000 | xargs kill -9 2>/dev/null || true
echo "✅ Servers stopped"
EOF
chmod +x stop

# Function to cleanup on exit
cleanup() {
    echo
    log "🛑 Stopping servers..."
    kill $BACKEND_PID $FRONTEND_PID 2>/dev/null || true
    pkill -f "uvicorn.*8000" 2>/dev/null || true
    pkill -f "simple_frontend.py" 2>/dev/null || true
    success "Servers stopped"
    exit 0
}

# Set up signal handlers
trap cleanup SIGINT SIGTERM

# Keep script running and monitor processes
log "Monitoring servers... (Press Ctrl+C to stop)"
while true; do
    if ! kill -0 $BACKEND_PID 2>/dev/null; then
        error "Backend server died unexpectedly"
        cleanup
    fi
    if ! kill -0 $FRONTEND_PID 2>/dev/null; then
        error "Frontend server died unexpectedly"
        cleanup
    fi
    sleep 5
done
